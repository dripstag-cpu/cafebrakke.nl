---
// Footer. Styling staat in home.css.
import type { Lang } from '../i18n';
import { useCopy } from '../i18n/copy';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = useCopy(lang);
---
<footer>
  <div class="row">
    <div class="crest">Café Brakke<span>.</span></div>
    <div class="footer-col">
      <h3>{c.footer.address}</h3>
      <p>Rozengracht 16<br>1016 NB Amsterdam</p>
    </div>
    <div class="footer-col">
      <h3>{c.footer.contact}</h3>
      <p>
        <a href="tel:+31203201657">020 320 1657</a><br>
        <a href="mailto:hallo@cafebrakke.nl">hallo@cafebrakke.nl</a>
      </p>
    </div>
    <div class="footer-col">
      <h3>{c.footer.open}</h3>
      <p set:html={c.footer.hoursHtml} />
    </div>
  </div>
  <div class="colofon">
    <div>
      {c.footer.colofon}<br>
      <span class="footer-credit">{c.footer.credit} <a href="https://locallevers.com" target="_blank" rel="noopener">Local Levers</a></span>
    </div>
    <div>{c.footer.legal}</div>
  </div>
</footer>
